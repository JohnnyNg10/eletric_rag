# ==================== Application ====================
APP_NAME=Electric RAG System
DEBUG=false
ENV=production
API_V1_PREFIX=/api/v1

# ==================== Database ====================
# MySQL 配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_strong_password_here    # ⚠️ 必须修改
MYSQL_DB=electric_rag

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== Qdrant ====================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ==================== Elasticsearch ====================
ES_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ES_INDEX=documents

# ==================== MinIO ====================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_strong_minio_password    # ⚠️ 建议修改
MINIO_BUCKET=electric-rag
MINIO_SECURE=false

# ==================== MinerU ====================
MINERU_API_URL=http://mineru:8001
MINERU_ENABLED=true
MINERU_BACKEND=pipeline

# ==================== Celery ====================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================== LLM API ====================
# 豆包 API 配置
ARK_API_KEY=your_api_key_here               # ⚠️ 必须填写
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=your_model_endpoint_here          # ⚠️ 必须填写（如 ep-20260717095008-vr5r8）

# ==================== VLM API ====================
# 用于扫描版 PDF 的图像描述（火山引擎豆包多模态）
VLM_PROVIDER=doubao
DOUBAO_API_KEY=your_api_key_here            # ⚠️ 如果启用 VLM 需填写
DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=your_vlm_model_endpoint_here   # ⚠️ 如果启用 VLM 需填写

# 通义千问 VLM（备选）
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-plus

# ==================== Business Config ====================
MAX_RECALL_COUNT=20
TOP_K_RESULTS=5
CACHE_TTL=3600

# ==================== Model Configuration ====================
MODELS_DIR=models
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL_LARGE=BAAI/bge-reranker-large
RERANKER_MODEL_BASE=BAAI/bge-reranker-base
SPARSE_MODEL=naver/efficient-splade-VI-BT-large-query
AUTO_DOWNLOAD_MODELS=true

# Embedding/Reranker Mode
EMBEDDING_MODE=local
RERANKER_MODE=local

# Embedding API Configuration (仅当 EMBEDDING_MODE=api 时使用)
EMBEDDING_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=bge-large-zh-v1.5

# Reranker API Configuration (仅当 RERANKER_MODE=api 时使用)
RERANKER_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RERANKER_API_KEY=
RERANKER_API_MODEL=bge-reranker-large

# ==================== GPU Configuration ====================
# GPU 设备（0 表示第一块 GPU）
CUDA_VISIBLE_DEVICES=0

# Reranker GPU 加速
RERANKER_USE_GPU=true
RERANKER_BATCH_SIZE=32    # Tesla V100 16GB: 32, 显存不足可降至 16 或 8

# OCR GPU 加速
OCR_USE_GPU=true
OCR_CONFIDENCE_THRESHOLD=0.85

# ==================== Scanned PDF Processing ====================
# 扫描版 PDF 处理（消耗较多 GPU 显存）
ENABLE_SCANNED_PDF=true     # 显存紧张时设为 false
ENABLE_IMAGE_SEARCH=true
ENABLE_VLM_DESCRIPTION=true

# ==================== Security ====================
SECRET_KEY=your_random_secret_key_at_least_32_chars    # ⚠️ 必须修改（运行 openssl rand -hex 32 生成）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== Logging ====================
LOG_LEVEL=INFO    # DEBUG/INFO/WARNING/ERROR
PYTHONUNBUFFERED=1

# ==================== Timezone ====================
TZ=Asia/Shanghai
