# Application
APP_NAME=Electric RAG System
DEBUG=True
ENV=development
API_V1_PREFIX=/api/v1

# Database - 请修改为你的 MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=electric_rag

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Elasticsearch
ES_HOSTS=http://localhost:9200
ES_INDEX=documents

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_EXTERNAL_ENDPOINT=  # 外部访问地址（可选），用于生成前端可访问的预签名URL，如 "172.20.108.156:9000"
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=electric-rag

# LLM API（豆包 Pro）
ARK_API_KEY=your_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=your_model_endpoint_here

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Business Config
MAX_RECALL_COUNT=20
TOP_K_RESULTS=5
CACHE_TTL=3600

# Model Configuration
MODELS_DIR=models
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL_LARGE=BAAI/bge-reranker-large
RERANKER_MODEL_BASE=BAAI/bge-reranker-base
SPARSE_MODEL=naver/efficient-splade-VI-BT-large-query
AUTO_DOWNLOAD_MODELS=True

# Embedding/Reranker Mode (local=本地模型, api=远程API)
EMBEDDING_MODE=local
RERANKER_MODE=local

# Embedding API Configuration (仅当 EMBEDDING_MODE=api 时使用)
EMBEDDING_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=bge-large-zh-v1.5

# Reranker API Configuration (仅当 RERANKER_MODE=api 时使用)
RERANKER_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RERANKER_API_KEY=
RERANKER_API_MODEL=bge-reranker-large

# Scanned PDF Processing
ENABLE_SCANNED_PDF=false
ENABLE_IMAGE_SEARCH=false
ENABLE_VLM_DESCRIPTION=false

# VLM API Configuration（火山引擎豆包多模态）
VLM_PROVIDER=doubao
DOUBAO_API_KEY=your_api_key_here
DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=your_vlm_model_endpoint_here
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-plus

# OCR Configuration
OCR_USE_GPU=True
OCR_CONFIDENCE_THRESHOLD=0.85

# MinerU Configuration
MINERU_API_URL=http://127.0.0.1:8001
MINERU_OUTPUT_DIR=../MinerU/output
MINERU_BACKEND=pipeline
MINERU_SYNC_TIMEOUT=120
MINERU_ASYNC_POLL_INTERVAL=3
MINERU_ASYNC_MAX_POLL_TIME=600
MINERU_ENABLED=True

# ========== 视觉检索配置 ==========

# 全局开关（唯一的功能开关）
ENABLE_VISUAL_RECALL=true

# ColPali 模型配置（使用 vidore/colqwen2-base）
COLPALI_MODEL_NAME=vidore/colqwen2-base
COLPALI_MODEL_CACHE_DIR=C:\Users\39948\.cache\modelscope\hub\models\vidore\colqwen2-base  # ModelScope 缓存路径
COLPALI_DEVICE=cpu  # cuda / cpu
COLPALI_VECTOR_DIM=128  # colqwen2-base 向量维度

# 性能配置
VISUAL_RECALL_TIMEOUT_MS=500        # 超时时间（毫秒）
VISUAL_RECALL_CACHE_TTL=3600       # 缓存时长（秒）
VISUAL_RECALL_TOP_K=50             # 召回数量

# 索引策略（按需索引，节省存储）
COLPALI_INDEX_MIN_SIZE=1000000     # 最小图片尺寸（像素，1MP）
COLPALI_INDEX_MAX_SIZE=100000000   # 最大图片尺寸（100MP）
COLPALI_INDEX_MIN_TEXT_DENSITY=30  # 最小文字标注数

# RRF 参数（固定权重）
RRF_K_PARAMETER=60                 # RRF 排名衰减参数
RRF_TEXT_WEIGHT=0.75               # 文本路径权重（固定，包含3路）
RRF_VISUAL_WEIGHT=0.25             # 视觉路径权重（固定，单路）

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
